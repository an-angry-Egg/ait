{
  "manifest_version": 3,
  "name": "AIT 点睛",
  "version": "0.1.0",
  "description": "画个圈，说一句，把改动连同源码位置交给 Agent。",
  "key": "",
  "permissions": ["clipboardWrite", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
